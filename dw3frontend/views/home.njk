
{% extends "layout.njk" %}

{% block content %}
    <header class="page-header">
        <p class="page-kicker text-primary fw-semibold mb-2">Sistema administrativo</p>
        <h1 class="display-6 fw-bold mb-2">Painel principal</h1>
        <p class="text-secondary mb-0">Use a navegação superior para acessar ou sair da aplicação.</p>
    </header>

    <div class="hero-card card border-0 shadow-sm">
        <div class="card-body p-4 p-lg-5">
            <div class="row g-4 align-items-center">
                <div class="col-lg-8">
                    <h2 class="h4 fw-semibold mb-3">Bem-vindo ao sistema</h2>
                    <p class="text-secondary mb-0">Bem-vindo ao sistema de gerenciamento de pastagens e animais.</p>
                </div>

                <div class="col-lg-4 text-lg-end">
                    <a class="btn btn-primary" href="/alocado">Ir para alocados</a>
                    <a class="btn btn-primary" href="/animal">Animais</a>
                    <a class="btn btn-primary" href="/pasto">Pasto</a>
                    <a class="btn btn-primary" href="/piquete">Piquete</a>
                </div>
            </div>
        </div>
    </div>

    <script src="/js/dw3frontend.js"></script>
    <script src="/apps/home/vwHome.js"></script>
{% endblock %}
